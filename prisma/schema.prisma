datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Category {
  FIRST_AID
  RAIN
  HYGIENE
  ELECTRONICS
}

enum OrderStatus {
  PENDING
  DISPENSING
  COMPLETED
  FAILED
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  price       Int // stored in satang-free THB integer (baht)
  image       String
  stock       Int      @default(0)
  maxStock    Int
  slot        String   @unique
  category    Category
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category])
}

model Order {
  id           String      @id @default(cuid())
  totalAmount  Int
  cashReceived Int         @default(0)
  changeAmount Int         @default(0)
  status       OrderStatus @default(PENDING)
  createdAt    DateTime    @default(now())

  items OrderItem[]

  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Int
  quantity    Int
  subtotal    Int
  slot        String // snapshot of the product's slot at order time, for the dispenser
  dispensed   Boolean @default(false)

  @@index([orderId])
  @@index([productId])
}

model MachineCash {
  denomination Int      @id // 5, 10, 20, 50, 100
  count        Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model AdminAccount {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
}
